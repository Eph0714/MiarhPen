<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes only the app's cache directory (where AppUpdaterService saves
     a downloaded update APK) via the FileProvider declared in
     AndroidManifest.xml — nothing else in the app's storage is shared. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="updates" path="." />
</paths>
